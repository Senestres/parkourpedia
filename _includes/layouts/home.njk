---
layout: layouts/base.njk
---
<h1>{{ "explorer" | t | capitalize }}</h1>
<pagefind-config instance="explorer" faceted preload excerpt-length="0"></pagefind-config>

<div class="explorer-grid">
    <noscript>
        Javascript is necessary to use this site. But if not possible, you can try <a href="/{{ lang }}/tags/">browsing manually</a>.
    </noscript>
    <div class="box-filter" >
        <pagefind-input instance="explorer"></pagefind-input>
        <pagefind-summary instance="explorer"></pagefind-summary>
        <pagefind-filter-pane instance="explorer" open="{{ "catégorie" | t}}, {{"forme caractéristique" | t}}, {{"niveau" | t}}"></pagefind-filter-pane>
    </div>
    <div class="explorer-results">
        <pagefind-results instance="explorer" hide-sub-results="true" show-images="false" id="explorer"></pagefind-results>
    </div>
</div>

{{ content | safe }}
